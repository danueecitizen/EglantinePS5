From c568ac8802cf2b9431728c35317c0f40c950ffe4 Mon Sep 17 00:00:00 2001
From: danueecitizen <danueecitizen@gmail.com>
Date: Sat, 7 Nov 2026 18:50:01 -0400
Subject: [PATCH 3/5] shader, buffer_cache: let compute programs bind up to 64
 storage buffers

From Djihads80/Eglantine de4ed9d9.
Allows OoT foliage generator (which uses 29 SSBOs) to bind all Hyrule Field grass sections.
---
 .../global_memory_to_storage_buffer_pass.cpp  | 22 ++++++++++++++++---
 src/shader_recompiler/shader_info.h           |  5 ++++-
 src/video_core/buffer_cache/buffer_cache.h    |  4 ++--
 .../buffer_cache/buffer_cache_base.h          | 12 +++++-----
 .../renderer_vulkan/vk_pipeline_cache.cpp     |  2 +-
 5 files changed, 33 insertions(+), 12 deletions(-)

diff --git a/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp b/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
index f99845b..954cee7 100644
--- a/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
+++ b/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
@@ -1730,23 +1730,39 @@ void GlobalMemoryToStorageBufferPass(Environment& env, IR::Program& program,
         info = std::move(paired);
         collect();
     }
+    // Compute programs may bind up to Info::MAX_SSBOS (64) storage buffers, so pointer table
+    // entries still fit when the program's own pointers take most of 32. Ocarina of Time's foliage
+    // list builder has 29 of its own: the table entries of its last two sections (Hyrule Field
+    // grass) did not fit, read zeros and the grass list stayed empty.
+    // EDEN_NX2_WIDE_COMPUTE_SSBOS=0 restores the 32-binding limit.
+    static const bool wide_compute = [] {
+        const char* const value = std::getenv("EDEN_NX2_WIDE_COMPUTE_SSBOS");
+        return !(value && value[0] == '0');
+    }();
+    const size_t max_ssbos{env.ShaderStage() == Stage::Compute && wide_compute
+                               ? Info::MAX_SSBOS
+                               : Info::MAX_GRAPHICS_SSBOS};
     const size_t reserved{info.tables_seen ? PendingNvnBindings(program, info.set) : 0U};
-    if (info.tables_seen && info.set.size() + reserved < Info::MAX_SSBOS) {
+    if (info.tables_seen && info.set.size() + reserved < max_ssbos) {
         // Again with pointer table entries, in the bindings the first pass left free.
         StorageInfo with_tables;
         with_tables.iterator_words = std::move(info.iterator_words);
         with_tables.atomic_pointers = std::move(info.atomic_pointers);
         with_tables.bind_competing_loaded = info.bind_competing_loaded;
         with_tables.tables_enabled = true;
-        with_tables.table_budget = Info::MAX_SSBOS - info.set.size() - reserved;
+        with_tables.table_budget = max_ssbos - info.set.size() - reserved;
         info = std::move(with_tables);
         collect();
     } else if (info.tables_seen) {
         info.bindings_full = true;
     }
+    if (info.set.size() > max_ssbos) {
+        throw NotImplementedException("{} storage buffers, the limit is {}", info.set.size(),
+                                      max_ssbos);
+    }
     if (info.bindings_full) {
         LOG_WARNING(Shader, "All {} storage buffer bindings taken, the rest stay global",
-                    Info::MAX_SSBOS);
+                    max_ssbos);
     }
     program.info.native_global_bounds |= info.native_runtime_bounds;
     for (const StorageBufferAddr& storage_buffer : info.set) {
diff --git a/src/shader_recompiler/shader_info.h b/src/shader_recompiler/shader_info.h
index 5985d13..1c091bc 100644
--- a/src/shader_recompiler/shader_info.h
+++ b/src/shader_recompiler/shader_info.h
@@ -278,7 +278,10 @@ struct MeshInfo {
 struct Info {
     static constexpr size_t MAX_INDIRECT_CBUFS{14};
     static constexpr size_t MAX_CBUFS{18};
-    static constexpr size_t MAX_SSBOS{32};
+    /// Compute programs can bind up to MAX_SSBOS storage buffers; graphics programs and compute
+    /// programs with EDEN_NX2_WIDE_COMPUTE_SSBOS=0 keep the old limit of MAX_GRAPHICS_SSBOS.
+    static constexpr size_t MAX_SSBOS{64};
+    static constexpr size_t MAX_GRAPHICS_SSBOS{32};
 
     bool is_task{}; ///< Switch 2 task program (Stage::Task)
     bool is_mesh{}; ///< Switch 2 mesh program (Stage::Mesh)
diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
index 8c7de20..ab6334a 100644
--- a/src/video_core/buffer_cache/buffer_cache.h
+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -846,8 +846,8 @@ void BufferCache<P>::BindComputeStorageBuffer(size_t ssbo_index, u32 cbuf_index,
             }
         }
     }
-    channel_state->enabled_compute_storage_buffers |= 1U << ssbo_index;
-    channel_state->written_compute_storage_buffers |= (is_written ? 1U : 0U) << ssbo_index;
+    channel_state->enabled_compute_storage_buffers |= u64{1} << ssbo_index;
+    channel_state->written_compute_storage_buffers |= u64{is_written ? 1U : 0U} << ssbo_index;
     if constexpr (requires { runtime.ShouldLimitDynamicStorageBuffers(); }) {
         if (runtime.ShouldLimitDynamicStorageBuffers() && !already_enabled) {
             ++channel_state->total_compute_storage_buffers;
diff --git a/src/video_core/buffer_cache/buffer_cache_base.h b/src/video_core/buffer_cache/buffer_cache_base.h
index 85e1871..3e0f96b 100644
--- a/src/video_core/buffer_cache/buffer_cache_base.h
+++ b/src/video_core/buffer_cache/buffer_cache_base.h
@@ -64,6 +64,8 @@ constexpr u32 NUM_GRAPHICS_UNIFORM_BUFFERS = 18;
 constexpr u32 NUM_COMPUTE_UNIFORM_BUFFERS = 8;
 // Native compute shaders bind up to 18 global memory ranges; the enable masks are 32 bits wide.
 constexpr u32 NUM_STORAGE_BUFFERS = 32;
+// Compute programs can take pointer table entries beyond 32 bindings (Shader::Info::MAX_SSBOS).
+constexpr u32 NUM_COMPUTE_STORAGE_BUFFERS = 64;
 constexpr u32 NUM_TEXTURE_BUFFERS = 32;
 constexpr u32 NUM_STAGES = 5;
 
@@ -140,7 +142,7 @@ public:
     Binding indirect_buffer_binding;
 
     std::array<Binding, NUM_COMPUTE_UNIFORM_BUFFERS> compute_uniform_buffers;
-    std::array<Binding, NUM_STORAGE_BUFFERS> compute_storage_buffers;
+    std::array<Binding, NUM_COMPUTE_STORAGE_BUFFERS> compute_storage_buffers;
     std::array<TextureBufferBinding, NUM_TEXTURE_BUFFERS> compute_texture_buffers;
 
     std::array<u32, NUM_STAGES> enabled_uniform_buffer_masks{};
@@ -151,8 +153,8 @@ public:
 
     std::array<u32, NUM_STAGES> enabled_storage_buffers{};
     std::array<u32, NUM_STAGES> written_storage_buffers{};
-    u32 enabled_compute_storage_buffers = 0;
-    u32 written_compute_storage_buffers = 0;
+    u64 enabled_compute_storage_buffers = 0;
+    u64 written_compute_storage_buffers = 0;
 
     u32 total_graphics_storage_buffers = 0;
     u32 total_compute_storage_buffers = 0;
@@ -491,8 +493,8 @@ public:
     }
 
 private:
-    template <typename Func>
-    static void ForEachEnabledBit(u32 enabled_mask, Func&& func) {
+    template <typename Mask, typename Func>
+    static void ForEachEnabledBit(Mask enabled_mask, Func&& func) {
         for (u32 index = 0; enabled_mask != 0; ++index, enabled_mask >>= 1) {
             const int disabled_bits = std::countr_zero(enabled_mask);
             index += disabled_bits;
diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
index 850f790..b757c97 100644
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -78,7 +78,7 @@ using VideoCommon::FileEnvironment;
 using VideoCommon::GenericEnvironment;
 using VideoCommon::GraphicsEnvironment;
 
-constexpr u32 CACHE_VERSION = 23;
+constexpr u32 CACHE_VERSION = 24;
 constexpr size_t VULKAN_CACHE_FLUSH_PIPELINES = 128;
 constexpr size_t VULKAN_CACHE_FLUSH_MIN_SECONDS = 30;
 constexpr std::array<char, 8> VULKAN_CACHE_MAGIC_NUMBER{'y', 'u', 'z', 'u', 'v', 'k', 'c', 'h'};
